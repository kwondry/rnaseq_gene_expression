/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

----------------------------------------------------------------------------------------
*/

profiles {

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = '--no-home'
        singularity.cacheDir = '/n/app/containers/shared/nf-core/rnaseq/3.20.0'
    }

    cluster {
        process {
            executor = 'slurm'
            cache = 'lenient'
            queue = { task.time > 5.d ? 'long' : task.time <= 12.h ? 'short' : 'medium'}
        }
    }

    local {
        process.executor = 'local'
    }
}


executor {
    slurm {
        queueSize = 1900
        submitRateLimit = '20 sec'
        queueGlobalStatus = true
    }
}

process {
    resourceLimits = [
        memory: 64.GB,
        cpus: 12,
        time: 11.h
    ]
}